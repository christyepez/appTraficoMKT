{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Aprobacion de producto",
      "weight": "Bolder",
      "size": "Large",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${subject}",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Producto", "value": "${productId}" },
        { "title": "Tipo", "value": "${productType}" },
        { "title": "Responsable", "value": "${productResponsible}" },
        { "title": "Requerimiento", "value": "${requirementId}" },
        { "title": "Canal", "value": "${diffusionChannel}" },
        { "title": "KPI", "value": "${mainKpi}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Revise los adjuntos dentro de la aplicacion antes de decidir.",
      "wrap": true
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.OpenUrl",
          "title": "Abrir producto",
          "url": "${productUrl}"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "comments",
      "label": "Comentarios",
      "isMultiline": true,
      "placeholder": "Ingrese comentarios para aprobar o rechazar"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Aprobar",
      "data": {
        "decision": "approved"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Rechazar",
      "data": {
        "decision": "rejected"
      }
    }
  ]
}
